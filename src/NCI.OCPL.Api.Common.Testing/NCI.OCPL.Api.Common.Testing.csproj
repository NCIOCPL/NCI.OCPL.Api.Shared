<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>4.0.0</Version>
    <PackageDescription>Testing utilities for NCI.OCPL.Api.Common.</PackageDescription>
    <RepositoryUrl>https://github.com/NCIOCPL/NCI.OCPL.Api.Shared</RepositoryUrl>
    <Authors>National Cancer Institute - Office of Communications and Public Liaison</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Elasticsearch doesn't strictly follow semantic versioning; the client MUST
          be locked to the same version as the server. -->
    <PackageReference Include="Elastic.Clients.Elasticsearch" Version="8.19.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NCI.OCPL.Api.Common/NCI.OCPL.Api.Common.csproj" />
  </ItemGroup>

</Project>
